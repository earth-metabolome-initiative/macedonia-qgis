        <default field="uuid_qfield" expression=" uuid('WithoutBraces')" applyOnUpdate="0"/>
        <default field="MatchedCanonical" expression="attribute(get_feature('species_list', 'ScientificName', &quot;taxon_name&quot;), 'MatchedCanonical')" applyOnUpdate="1"/>
        <default field="TaxonId" expression="attribute(get_feature('species_list', 'ScientificName', &quot;taxon_name&quot;), 'TaxonId')" applyOnUpdate="1"/>
        <default field="taxon_name_final" expression="coalesce(nullif(trim(&quot;taxon_name&quot;), ''),nullif(trim(&quot;name_proposition&quot;), ''))" applyOnUpdate="1"/>
